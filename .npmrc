# =============================================================================
# Shisho Guard (Takumi Guard) — Supply Chain Protection
# =============================================================================
# npm.flatt.tech は npm 公式レジストリへのセキュリティプロキシ。
# 悪意あるパッケージを自動ブロック。Bot ID 不要（匿名モード）。
# Renovate も pnpm install 時にこの .npmrc を読むため自動的に保護される。

registry=https://npm.flatt.tech/

# --- Supply Chain Hardening ---
strict-peer-dependencies=true
save-exact=true
frozen-lockfile=true
only-built-dependencies-file=.onlybuilt.json

# --- Audit ---
audit=true
audit-level=moderate
