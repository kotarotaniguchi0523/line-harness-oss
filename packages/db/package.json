{
	"name": "@line-crm/db",
	"version": "0.3.0",
	"description": "D1 database - Drizzle ORM schemas, repositories, migrations",
	"license": "MIT",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema/index.ts",
		"./schema/*": "./src/schema/*",
		"./drizzle": "./src/drizzle.ts",
		"./repositories/*": "./src/repositories/*.ts"
	},
	"files": [
		"src",
		"schema.sql",
		"migrations"
	],
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"generate": "drizzle-kit generate",
		"migrate": "drizzle-kit migrate"
	},
	"dependencies": {
		"@line-crm/domain": "workspace:*",
		"dayjs": "^1.11.20",
		"drizzle-orm": "^0.39.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20241205.0",
		"drizzle-kit": "^0.30.0",
		"typescript": "^5.7.0",
		"vitest": "^2.1.9"
	},
	"keywords": [
		"line",
		"crm",
		"d1",
		"cloudflare",
		"drizzle"
	]
}
